<resources>
    <style name="Theme.WatchTogether" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#33E5484D</item>
        <item name="colorOnSecondaryContainer">@color/accent</item>
    </style>

    <style name="GlassIcon">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/glass_circle</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Theme.WatchTogether.Sheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="colorPrimary">@color/accent</item>
        <!-- Makes YouTube's site use its dark theme -->
        <item name="android:isLightTheme">false</item>
    </style>

    <style name="JoinField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/join_field</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#66FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
</resources>
