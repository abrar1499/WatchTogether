<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/join_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_launcher" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/setupWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/setup_needed"
                android:textColor="#FFB3B6"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- One compact card holds everything -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/join_card"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/nameInput"
                    style="@style/JoinField"
                    android:hint="@string/your_name"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/createButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/accent"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0.02"
                    android:text="@string/create_room"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:cornerRadius="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#1AFFFFFF" />

                    <TextView
                        android:id="@+id/orText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:text="@string/or_join"
                        android:textColor="#66FFFFFF"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#1AFFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/codeInput"
                        style="@style/JoinField"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:hint="@string/room_code"
                        android:imeOptions="actionGo"
                        android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                        android:letterSpacing="0.18"
                        android:maxLength="6" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/joinButton"
                        android:layout_width="wrap_content"
                        android:layout_height="54dp"
                        android:layout_marginStart="10dp"
                        android:backgroundTint="#1FFFFFFF"
                        android:fontFamily="sans-serif-medium"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="@string/join_room"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="end"
                        app:iconPadding="6dp"
                        app:iconSize="18dp"
                        app:iconTint="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="18dp"
                android:indeterminateTint="#B3FFFFFF"
                android:visibility="invisible" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/versionText"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:textColor="#40FFFFFF"
        android:textSize="11sp" />
</FrameLayout>
