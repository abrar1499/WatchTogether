<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- The whole screen is the player page: video on top, its reflection below -->
    <WebView
        android:id="@+id/player"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Catches every tap so YouTube's page never reacts; tapping shows our controls -->
    <View
        android:id="@+id/touchShield"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Our own loading screen while a new video starts, so YouTube's page is never seen -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/loadingBlur"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.6"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/loadingMid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.5" />

        <ImageView
            android:id="@+id/loadingThumb"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.55"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toTopOf="@id/loadingMid"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/loading_scrim"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.abrar.watchtogether.LoaderView
            android:id="@+id/loader"
            android:layout_width="96dp"
            android:layout_height="96dp"
            app:layout_constraintBottom_toTopOf="@id/loadingMid"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Small spinner when the video pauses to buffer -->
    <com.abrar.watchtogether.LoaderView
        android:id="@+id/bufferLoader"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/mid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- TikTok mode: the real TikTok feed fills the room (above the video, below the chat) -->
    <FrameLayout
        android:id="@+id/tiktokHost"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/inputBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Chat floats over video and reflection; older messages dim step by step -->
    <com.abrar.watchtogether.FadingRecyclerView
        android:id="@+id/chatList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="14dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/inputBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Our own controls, only over the video half -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/top_scrim"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/mid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <ImageButton
                android:id="@+id/backButton"
                style="@style/GlassIcon"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/roomCode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/glass_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="false"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/memberCount"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/glass_pill"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_people_small" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/youtubeButton"
                style="@style/GlassIcon"
                android:contentDescription="@string/open_youtube"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/volumeButton"
                style="@style/GlassIcon"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/volume"
                android:src="@drawable/ic_volume_up" />

            <ImageButton
                android:id="@+id/shareButton"
                style="@style/GlassIcon"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/invite"
                android:src="@drawable/ic_person_add" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/playPause"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:alpha="0.9"
            android:background="@drawable/glass_circle"
            android:contentDescription="@string/play_pause"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play" />

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:alpha="0.9"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="0:00 / 0:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:progressBackgroundTint="#66FFFFFF"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF" />

            <ImageButton
                android:id="@+id/resyncButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/resync"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sync" />

            <ImageButton
                android:id="@+id/cropButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/crop"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_crop" />

            <ImageButton
                android:id="@+id/fullscreenButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/fullscreen"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_fullscreen" />
        </LinearLayout>
    </FrameLayout>

    <!-- Shown before any video is picked -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/mid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/emptySearchInput"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/glass_input"
                android:drawableStart="@drawable/ic_search_small"
                android:drawablePadding="10dp"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="18dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/emptySearchButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/send_circle"
                android:contentDescription="@string/search"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/exitTikTok"
        style="@style/GlassIcon"
        android:layout_marginStart="10dp"
        android:layout_marginTop="40dp"
        android:contentDescription="@string/close"
        android:src="@drawable/ic_close"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- "+10s" hint for double-tap seeking -->
    <TextView
        android:id="@+id/seekHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:background="@drawable/chat_toast_bg"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/chatToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/chat_toast_bg"
        android:maxWidth="320dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:textColor="#E6FFFFFF"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/glass_input"
            android:hint="@string/message_hint"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textShortMessage|textCapSentences"
            android:maxLines="1"
            android:paddingHorizontal="20dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/send_circle"
            android:contentDescription="@string/send"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
